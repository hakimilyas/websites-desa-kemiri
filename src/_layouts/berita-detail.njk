---
layout: base.njk
---

<article class="py-12 bg-slate-50 min-h-screen">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Back Navigation Button -->
    <div class="mb-8">
      <a href="/berita/" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white text-emerald-700 font-semibold text-sm border border-emerald-200 hover:bg-emerald-50 hover:border-emerald-300 shadow-sm transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Kembali ke Berita</span>
      </a>
    </div>

    <!-- Article Header Card -->
    <header class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6 mb-8">
      <div class="flex items-center gap-3 flex-wrap text-xs">
        <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-bold uppercase tracking-wider">
          Berita Desa
        </span>
        <span class="text-slate-400">•</span>
        <time class="text-slate-500 font-medium flex items-center gap-1">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {{ date | readableDate }}
        </time>
        {% if author %}
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium flex items-center gap-1">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            {{ author }}
          </span>
        {% endif %}
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight tracking-tight">
        {{ title }}
      </h1>

      {% if excerpt %}
        <p class="text-lg text-slate-600 leading-relaxed font-normal italic border-l-4 border-emerald-500 pl-4 py-1">
          {{ excerpt }}
        </p>
      {% endif %}
    </header>

    <!-- Cover Image -->
    {% if cover_image %}
      <div class="rounded-3xl overflow-hidden shadow-lg border border-slate-200 mb-10 max-h-[480px] bg-slate-900">
        <img src="{{ cover_image }}" alt="{{ title }}" class="w-full h-full object-cover">
      </div>
    {% endif %}

    <!-- Article Content -->
    <main class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-6 text-slate-800 leading-relaxed text-base">
      <div class="prose prose-emerald max-w-none space-y-4">
        {{ content | safe }}
      </div>
    </main>

    <!-- Bottom Navigation Footer -->
    <div class="mt-10 pt-6 border-t border-slate-200 flex justify-between items-center">
      <a href="/berita/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-700 text-white font-bold text-sm shadow-md hover:bg-emerald-800 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Lihat Semua Berita</span>
      </a>
    </div>

  </div>
</article>
