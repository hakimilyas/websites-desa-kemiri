---
layout: base.njk
title: "Galeri Foto Desa"
permalink: "/galeri/index.html"
description: "Dokumentasi keindahan alam, pemandangan, dan kegiatan warga Desa Kemiri."
---

<!-- Header Section -->
<section class="bg-gradient-to-b from-emerald-900 to-slate-900 text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
    <h1 class="text-4xl font-extrabold tracking-tight">Galeri Foto & Abadikan Momen</h1>
    <p class="text-emerald-100 text-lg max-w-2xl mx-auto">
      Kumpulan dokumentasi panorama alam dan hangatnya kebersamaan kegiatan warga Desa Kemiri.
    </p>
  </div>
</section>

<!-- Pure Image Gallery Grid & Lightbox Section -->
<section class="py-16 bg-slate-50" x-data="{ 
  activeLightboxIndex: null,
  items: [
    {% for item in collections.galeri %}
      {
        image: '{{ item.data.image }}',
        title: '{{ item.data.title | escape }}'
      }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  prev() {
    if (this.activeLightboxIndex !== null) {
      this.activeLightboxIndex = this.activeLightboxIndex === 0 ? this.items.length - 1 : this.activeLightboxIndex - 1;
    }
  },
  next() {
    if (this.activeLightboxIndex !== null) {
      this.activeLightboxIndex = this.activeLightboxIndex === this.items.length - 1 ? 0 : this.activeLightboxIndex + 1;
    }
  }
}"
@keydown.window.escape="activeLightboxIndex = null"
@keydown.window.left="prev()"
@keydown.window.right="next()">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Gallery Grid (Pure Image Grid) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 sm:gap-6">
      <template x-for="(item, index) in items" :key="index">
        <div @click="activeLightboxIndex = index"
             class="group relative aspect-square rounded-2xl overflow-hidden shadow-sm hover:shadow-xl bg-slate-200 border border-slate-200 cursor-pointer transition-all duration-300">
          
          <!-- Image -->
          <img :src="item.image" :alt="item.title" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          
          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <span class="px-4 py-2 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-bold flex items-center gap-1.5 shadow-lg">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
              <span>Perbesar</span>
            </span>
          </div>

        </div>
      </template>
    </div>

  </div>

  <!-- Fullscreen Lightbox Modal (Alpine.js) -->
  <div x-show="activeLightboxIndex !== null" 
       x-cloak
       class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6"
       role="dialog">
    
    <!-- Lightbox Backdrop -->
    <div x-show="activeLightboxIndex !== null"
         x-transition:enter="ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         @click="activeLightboxIndex = null"
         class="fixed inset-0 bg-slate-950/90 backdrop-blur-md"></div>

    <!-- Lightbox Popup Content (Pure Image View) -->
    <div x-show="activeLightboxIndex !== null"
         x-transition:enter="ease-out duration-300"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="ease-in duration-200"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="relative z-10 max-w-5xl w-full bg-slate-950 rounded-2xl overflow-hidden shadow-2xl border border-slate-800 text-white flex flex-col items-center justify-center min-h-[50vh] max-h-[85vh]">
      
      <!-- Close Button -->
      <button @click="activeLightboxIndex = null" 
              type="button"
              class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center transition-colors shadow-lg"
              aria-label="Tutup modal">
        ✕
      </button>

      <!-- Previous Image Button -->
      <button @click="prev()" 
              type="button"
              class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center transition-colors shadow-lg text-2xl font-bold"
              aria-label="Foto Sebelumnya">
        ‹
      </button>

      <!-- Next Image Button -->
      <button @click="next()" 
              type="button"
              class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center transition-colors shadow-lg text-2xl font-bold"
              aria-label="Foto Selanjutnya">
        ›
      </button>

      <!-- Enlarged Image -->
      <div class="w-full h-full p-4 flex items-center justify-center overflow-hidden">
        <img :src="activeLightboxIndex !== null ? items[activeLightboxIndex].image : ''" 
             :alt="activeLightboxIndex !== null ? items[activeLightboxIndex].title : ''" 
             class="max-h-[80vh] w-auto object-contain rounded-lg shadow-2xl transition-all duration-300">
      </div>

    </div>
  </div>

</section>
