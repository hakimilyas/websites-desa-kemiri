---
layout: base.njk
title: "Profil & Infografis Desa"
permalink: "/profil/index.html"
description: "Profil lengkap, sejarah, peta geografis, dan statistik infografis Desa Kemiri."
---

<!-- Header Section -->
<section class="bg-gradient-to-b from-emerald-900 to-slate-900 text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
    <h1 class="text-4xl font-extrabold tracking-tight">Profil & Infografis Desa Kemiri</h1>
    <p class="text-emerald-100 text-lg max-w-3xl mx-auto">
      {{ profil.short_description }}
    </p>
  </div>
</section>

<!-- Infographic Stat Cards Section -->
<section class="py-12 bg-white -mt-8 relative z-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      
      <!-- Dusun -->
      <div class="p-6 rounded-2xl bg-emerald-50 border border-emerald-100 text-center shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-xl">
          🏛️
        </div>
        <div class="text-3xl font-extrabold text-slate-900 mb-1">{{ profil.dusun_count }}</div>
        <div class="text-xs font-bold text-emerald-800 uppercase tracking-wider">Jumlah Dusun</div>
      </div>

      <!-- RW -->
      <div class="p-6 rounded-2xl bg-amber-50 border border-amber-100 text-center shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-amber-500 text-white flex items-center justify-center font-bold text-xl">
          🏡
        </div>
        <div class="text-3xl font-extrabold text-slate-900 mb-1">{{ profil.rw_count }}</div>
        <div class="text-xs font-bold text-amber-800 uppercase tracking-wider">Jumlah RW</div>
      </div>

      <!-- RT -->
      <div class="p-6 rounded-2xl bg-blue-50 border border-blue-100 text-center shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xl">
          🏘️
        </div>
        <div class="text-3xl font-extrabold text-slate-900 mb-1">{{ profil.rt_count }}</div>
        <div class="text-xs font-bold text-blue-800 uppercase tracking-wider">Jumlah RT</div>
      </div>

      <!-- KK -->
      <div class="p-6 rounded-2xl bg-purple-50 border border-purple-100 text-center shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-purple-600 text-white flex items-center justify-center font-bold text-xl">
          👨‍👩‍👧‍👦
        </div>
        <div class="text-3xl font-extrabold text-slate-900 mb-1">{{ profil.total_kk }}</div>
        <div class="text-xs font-bold text-purple-800 uppercase tracking-wider">Total KK</div>
      </div>

    </div>
  </div>
</section>

<!-- Carousel Photo Showcase (1:1 Ratio) & Narrative Section -->
<section class="py-16 bg-slate-50 border-t border-slate-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Alpine.js Photo Carousel (Rasio 1:1) -->
      <div class="lg:col-span-5" x-data="{ activeSlide: 0, slides: {{ profil.carousel_images | json }} }">
        <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-square bg-slate-200 border border-slate-300">
          <template x-for="(slide, index) in slides" :key="index">
            <div x-show="activeSlide === index" 
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 class="absolute inset-0">
              <img :src="slide.image" :alt="slide.caption" class="w-full h-full object-cover">
              <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950 via-slate-900/70 to-transparent p-4 text-white">
                <p class="text-xs font-semibold text-emerald-300" x-text="`Foto ${index + 1} dari ${slides.length}`"></p>
                <p class="text-sm font-bold" x-text="slide.caption"></p>
              </div>
            </div>
          </template>

          <!-- Carousel Nav Buttons -->
          <button @click="activeSlide = activeSlide === 0 ? slides.length - 1 : activeSlide - 1" 
                  class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/80 backdrop-blur-sm text-slate-800 flex items-center justify-center shadow hover:bg-white transition-colors"
                  aria-label="Previous Slide">
            ‹
          </button>
          <button @click="activeSlide = activeSlide === slides.length - 1 ? 0 : activeSlide + 1" 
                  class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/80 backdrop-blur-sm text-slate-800 flex items-center justify-center shadow hover:bg-white transition-colors"
                  aria-label="Next Slide">
            ›
          </button>
        </div>

        <!-- Indicators -->
        <div class="flex justify-center gap-2 mt-4">
          <template x-for="(slide, index) in slides" :key="index">
            <button @click="activeSlide = index" 
                    :class="activeSlide === index ? 'bg-emerald-600 w-6' : 'bg-slate-300 w-2'" 
                    class="h-2 rounded-full transition-all duration-300"
                    :aria-label="`Go to slide ${index + 1}`">
            </button>
          </template>
        </div>
      </div>

      <!-- History & Narrative -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-700 bg-emerald-100 px-3 py-1 rounded-md">
            Narasi Lengkap
          </span>
          <h2 class="text-3xl font-bold text-slate-900 mt-3">Sejarah & Perkembangan Desa</h2>
        </div>

        <div class="prose prose-slate max-w-none text-slate-600 leading-relaxed space-y-4">
          {% for paragraph in profil.full_history.split('\n\n') %}
            <p>{{ paragraph }}</p>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Geographic Details Section -->
<section class="py-16 bg-white border-t border-slate-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-slate-900">Karakteristik Geografis</h2>
      <p class="text-slate-600 max-w-2xl mx-auto mt-2">
        Letak astronomis dan bentang alam wilayah Desa Kemiri.
      </p>
    </div>

    <div class="bg-slate-900 text-white rounded-2xl p-8 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-3">
        <h3 class="text-xl font-bold text-emerald-400">Kondisi Wilayah & Potensi Alam</h3>
        <p class="text-slate-300 text-sm leading-relaxed max-w-2xl">
          {{ profil.location_text }}
        </p>
      </div>

      <a href="{{ profil.maps_url }}" target="_blank" rel="noopener noreferrer" 
         class="shrink-0 px-6 py-3 rounded-xl font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg transition-transform hover:-translate-y-0.5 flex items-center gap-2">
        <span>Buka di Google Maps</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>

    {% if profil.peta_potensi_image %}
      <!-- Peta Potensi Desa Image Container -->
      <div class="mt-8 bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-lg space-y-3">
        <div class="overflow-hidden rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center">
          <img src="{{ profil.peta_potensi_image }}" 
               alt="Peta potensi dan sebaran UMKM Desa Kemiri" 
               loading="lazy" 
               class="w-full h-auto object-contain">
        </div>
        <p class="text-center text-xs sm:text-sm font-semibold text-slate-500 italic">
          🗺️ Peta Potensi & Sebaran Wilayah Desa Kemiri
        </p>
      </div>
    {% endif %}
  </div>
</section>
