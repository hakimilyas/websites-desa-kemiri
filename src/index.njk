---
layout: base.njk
title: "Beranda"
description: "Selamat Datang di Website Resmi Desa Kemiri. Informasi profil desa, pelayanan, UMKM, dan kegiatan warga."
---

<!-- Hero Section Cover Full-Width -->
<section class="relative min-h-[85vh] flex items-center justify-center bg-slate-900 text-white overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img src="{{ home.hero_image }}" alt="Suasana Desa Kemiri" class="w-full h-full object-cover object-center scale-105 transform animate-pulse duration-1000 opacity-40">
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-transparent"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 py-20">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 backdrop-blur-md border border-emerald-400/30 text-emerald-300 text-sm font-semibold tracking-wide">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      Portal Resmi Pemerintah Desa Kemiri
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
      {{ home.title }}
    </h1>

    <p class="text-lg sm:text-2xl text-emerald-100 font-light max-w-3xl mx-auto leading-relaxed">
      "{{ home.slogan }}"
    </p>

    <div class="pt-4 flex flex-wrap justify-center gap-4">
      <a href="/profil/" class="px-8 py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-700 hover:to-emerald-600 shadow-lg shadow-emerald-600/30 transition-all hover:-translate-y-0.5">
        Jelajahi Profil Desa
      </a>
      <a href="/umkm/" class="px-8 py-3.5 rounded-xl font-bold text-slate-800 bg-white hover:bg-slate-100 shadow-md transition-all hover:-translate-y-0.5">
        Lihat UMKM Desa
      </a>
    </div>
  </div>
</section>

<!-- History Summary Section -->
<section class="py-20 bg-white border-b border-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <div class="inline-block px-3.5 py-1.5 rounded-lg bg-emerald-100 text-emerald-800 font-bold text-xs uppercase tracking-wider">
          Sejarah Singkat
        </div>
        <h2 class="text-3xl font-extrabold text-slate-900">
          Mengenal Lebih Dekat Desa Kemiri
        </h2>
        <p class="text-slate-600 leading-relaxed text-base">
          {{ home.history_summary }}
        </p>
        <div>
          <a href="/profil/" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-semibold transition-colors shadow-md">
            <span>Baca Selengkapnya</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Feature Card Showcase -->
      <div class="relative">
        <div class="absolute -inset-2 rounded-2xl bg-gradient-to-tr from-emerald-600 to-amber-500 opacity-20 blur-xl"></div>
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-slate-200">
          <img src="{{ profil.carousel_images[0].image }}" alt="Lansekap Desa Kemiri" class="w-full h-80 object-cover">
          <div class="p-6 bg-slate-900 text-white">
            <h3 class="font-bold text-lg text-emerald-400 mb-1">Harmoni Alam & Warga</h3>
            <p class="text-slate-300 text-sm">Menjaga kelestarian kebun dan persawahan sebagai sumber daya kehidupan berkelanjutan.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Embedded Google Maps Section -->
<section class="py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
    <div>
      <h2 class="text-3xl font-extrabold text-slate-900 mb-3">Lokasi & Geografis Desa</h2>
      <p class="text-slate-600 max-w-2xl mx-auto text-base">
        {{ home.location_text }}
      </p>
    </div>

    <!-- Map Container -->
    <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200 bg-white h-[450px]">
      <iframe 
        src="{{ home.maps_embed_url }}" 
        class="w-full h-full border-0" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title="Peta Lokasi Desa Kemiri">
      </iframe>
    </div>
  </div>
</section>
